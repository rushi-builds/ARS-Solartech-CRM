{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ars-oms-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ars-oms-local",
      "database_id": "local-dev"
    }
  ],
  // APP_ORIGIN is deliberately unset: the Worker then derives the origin from
  // the request, so the same dev server works on localhost:8787, on a LAN IP and
  // behind the workspace preview proxy (which serves a different host).
  "vars": {}
}
